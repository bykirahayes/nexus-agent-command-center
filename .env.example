# Public configuration for the separately managed Supabase project.
# These two values are safe for browser use when Row Level Security is enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase configuration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional server-only admin key. Do not expose this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side AI provider credentials. Never prefix these with VITE_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# Optional cron protection secret.
NEXUS_CRON_SECRET=
NEXUS_CRON_SECRET_PREVIOUS=
